{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FreeCharles",
  "version": "1.0.0",
  "identifier": "com.freecharles.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "FreeCharles — HTTP 抓包代理",
        "width": 1480,
        "height": 920,
        "minWidth": 1040,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "backgroundColor": "#f4f6f9"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; frame-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
